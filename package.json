{
	"name": "metastack-markdown-extension",
	"description": "View, edit and manage local Markdown files in Chrome and Firefox",
	"license": "MIT",
	"author": "MetaStack Labs",
	"homepage": "https://github.com/metastack-labs/metastack-markdown-extension#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/metastack-labs/metastack-markdown-extension.git"
	},
	"bugs": {
		"url": "https://github.com/metastack-labs/metastack-markdown-extension/issues"
	},
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.3.11",
	"engines": {
		"node": ">=24",
		"bun": ">=1.3"
	},
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build && wxt build -b firefox",
		"build:chrome": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip && wxt zip -b firefox",
		"zip:chrome": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "node --test \"src/**/*.test.ts\"",
		"verify": "node scripts/verify-build.ts",
		"verify:sources": "node scripts/verify-sources.ts",
		"brand": "node scripts/brand-assets.ts",
		"check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run verify",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@codemirror/commands": "^6.8.0",
		"@codemirror/lang-markdown": "^6.3.0",
		"@codemirror/language": "^6.11.0",
		"@codemirror/language-data": "^6.5.0",
		"@codemirror/search": "^6.5.0",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.36.0",
		"@lezer/highlight": "^1.2.0",
		"@radix-ui/react-dropdown-menu": "^2.1.0",
		"clsx": "^2.1.1",
		"dompurify": "^3.3.0",
		"highlight.js": "^11.11.0",
		"katex": "^0.19.1",
		"lucide-react": "^1.70.0",
		"marked": "^18.1.3",
		"marked-footnote": "^1.4.0",
		"mermaid": "^12.3.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@wxt-dev/module-react": "^1.2.0",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.5",
		"typescript": "~7.0.2",
		"vite": "^8.3.6",
		"web-ext": "^10.8.0",
		"wxt": "^0.21.5"
	}
}
